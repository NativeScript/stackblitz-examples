<Page xmlns="http://schemas.nativescript.org/tns.xsd" navigatingTo="navigatingTo">
    <ActionBar title="NativeScript is pretty cool!" icon="" />

    <StackLayout class="p-5">
        <Label text="The Battery Level is:" class="text-3xl text-center mb-2" />
        <Label text="{{ level ? level + '%' : '---' }}" class="text-2xl text-center" />
        <Button text="{{ isListening ? 'Stop Listening to Battery Changes' : 'Listen for battery changes' }}" class="action-btn" tap="{{ toggleListenForChanges }}" />
        <Image src="https://upload.wikimedia.org/wikipedia/commons/thumb/4/4c/Typescript_logo_2020.svg/500px-Typescript_logo_2020.svg.png" width="200" class="mt-5" />
    </StackLayout>
</Page>
